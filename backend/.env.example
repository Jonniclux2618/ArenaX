# Backend Environment Variables

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/arenax
BACKEND_MIGRATION_MODE=run
REDIS_URL=redis://localhost:6379

# Redis failure semantics (Issue #93)
# Redis is used ONLY for derived/cache data (idempotency response cache,
# rate-limit counters, Pub/Sub fan-out). Authoritative match, session, and
# wallet state lives in Postgres and is never sourced solely from Redis.
#
# Degraded behavior when Redis is unavailable:
#   - idempotency cache: bypass cache, fall through to durable idempotency
#     records in Postgres (no duplicate work).
#   - rate limiting: fail-open (allow) so requests are not dropped; counters
#     rebuild on reconnect.
#   - Pub/Sub: reconnect with backoff; missed events are replayed from the
#     durable outbox in Postgres on recovery.
#
# Reconnect backoff (milliseconds) for the Redis client.
REDIS_RECONNECT_MIN_DELAY_MS=100
REDIS_RECONNECT_MAX_DELAY_MS=5000
# Max reconnect attempts before the client reports degraded readiness.
# 0 = retry indefinitely.
REDIS_RECONNECT_MAX_ATTEMPTS=0
# Timeout (milliseconds) for individual Redis commands before treating the
# operation as degraded.
REDIS_COMMAND_TIMEOUT_MS=500
# When true, readiness probes report not-ready while Redis is degraded.
# Keep false when Redis is cache-only so a cache outage does not fail traffic.
REDIS_REQUIRED_FOR_READINESS=false

# Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=secret
S3_BUCKET=arenax

# Payments
# Active gateway for wallet deposits: paystack (default) or flutterwave
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET=sk_test_xxx
FLUTTERWAVE_SECRET=FLWSECK_TEST-xxx

# Payment webhook verification (Issue #21)
# Signatures are verified over the RAW request body bytes (never the parsed or
# re-serialized JSON) using the secret for the active PAYMENT_PROVIDER. Secrets
# are selected by environment and must never be logged.
#
# Maximum age (seconds) of a provider event before it is rejected as stale.
# Events whose signed timestamp is older than this window are refused so a
# captured notification cannot be replayed later.
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
# Allowed clock skew (seconds) tolerated when comparing the signed timestamp
# against server time. Events dated further in the future are rejected.
PAYMENT_WEBHOOK_CLOCK_SKEW_SECONDS=60
# Durable idempotency: each provider event is keyed by a stable event identity
# (provider + event id) and applied at most once. Duplicate deliveries are
# acknowledged without re-applying wallet/payout mutations.
PAYMENT_WEBHOOK_IDEMPOTENCY_TTL_SECONDS=604800

# Authentication
JWT_SECRET=supersecretkey
# Short-lived access token TTL: supports s / m / h / d suffixes (e.g. "15m")
JWT_EXPIRES_IN=15m
# Long-lived refresh token TTL. Defaults to "7d" when unset.
JWT_REFRESH_EXPIRES_IN=7d

# Stellar Configuration
STELLAR_NETWORK_URL=https://horizon-testnet.stellar.org
STELLAR_ADMIN_SECRET=SBXXX...
SOROBAN_CONTRACT_PRIZE=CAXXX...
SOROBAN_CONTRACT_REPUTATION=CBXXX...
SOROBAN_CONTRACT_ARENAX_TOKEN=CCXXX...
# Optional: defaults to SOROBAN_CONTRACT_PRIZE if not set
SOROBAN_CONTRACT_MATCH=CDXXX...

# AI
AI_MODEL_PATH=./models/anti_cheat.tflite

# Server Configuration
PORT=8080
HOST=0.0.0.0
RUST_LOG=info

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
# Optional per-endpoint overrides: comma-separated bucket=limit:window pairs
# RATE_LIMIT_OVERRIDES=auth_strict=3:60,tournament=5:120,default=200:60

# Distributed rate limiting (Issue #84)
# Sensitive operations (auth, wallet, API-key, evidence-upload, expensive search)
# are limited via a shared Redis-backed limiter so limits hold across replicas.
# Namespace prefix for all limiter keys in Redis. Change to isolate environments
# that share a Redis instance.
RATE_LIMIT_REDIS_PREFIX=arenax:ratelimit
# Burst policy: token-bucket capacity per endpoint (tokens refill at
# limit/window). Requests beyond capacity are rejected with 429 + Retry-After.
# Comma-separated bucket=burst pairs; unset buckets default to their limit.
# RATE_LIMIT_BURST=auth=5,wallet=10,api_key=10,evidence_upload=3,search=20
# Trusted reverse proxies whose X-Forwarded-For / X-Real-IP headers are honored
# when resolving the client IP. Comma-separated CIDRs. Untrusted sources are
# ignored so forwarded headers cannot be spoofed to bypass limits.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Redis outage behavior per risk class: fail_open (allow) or fail_closed (deny).
# High-risk classes (auth, wallet, api_key) should fail closed; lower-risk
# classes (evidence_upload, search) may fail open to preserve availability.
RATE_LIMIT_FAIL_MODE_AUTH=fail_closed
RATE_LIMIT_FAIL_MODE_WALLET=fail_closed
RATE_LIMIT_FAIL_MODE_API_KEY=fail_closed
RATE_LIMIT_FAIL_MODE_EVIDENCE_UPLOAD=fail_open
RATE_LIMIT_FAIL_MODE_SEARCH=fail_open

# Idempotency
# TTL for cached idempotent responses in seconds (default: 86400 = 24 hours)
IDEMPOTENCY_TTL_SECONDS=86400
# Maximum response body size to cache in KB (default: 1024 = 1MB)
IDEMPOTENCY_MAX_RESPONSE_SIZE_KB=1024

# CORS
# Explicit least-privilege allowlist of trusted browser origins.
# Comma-separated, scheme + host (+ optional port), no trailing slash.
# Wildcards ("*") are rejected when credentials are enabled; credentialed
# requests require an explicit origin list. Keep production to real origins only.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Allow credentialed (cookie / Authorization) cross-origin requests.
# When true, ALLOWED_ORIGINS must be an explicit list (never "*").
CORS_ALLOW_CREDENTIALS=true

# Security headers / transport policy
# APP_ENV drives environment-specific policy: development | preview | production.
# In production the backend enforces HTTPS-only transport protections
# (HSTS, secure cookies, upgrade of insecure transport) and least-privilege CORS.
APP_ENV=development
# Emit Strict-Transport-Security on responses. Forced on in production.
SECURITY_HSTS_ENABLED=false
# HSTS max-age in seconds (default: 31536000 = 1 year).
SECURITY_HSTS_MAX_AGE=31536000
# Mark auth cookies Secure (HTTPS-only). Forced on in production.
SECURITY_COOKIE_SECURE=false
# Redirect/upgrade plaintext HTTP requests to HTTPS. Forced on in production.
SECURITY_FORCE_HTTPS=false

# Distributed tracing (OTLP/gRPC — points at a Jaeger or Datadog Agent
# collector). Leave unset to run with local logging only, no trace export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=arenax-backend

# Email notifications (Issue #905)
# Unset: email is written to the log instead of being delivered.
EMAIL_API_ENDPOINT=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# Base URL used to build unsubscribe and appeal links in outbound email.
APP_BASE_URL=https://arenax.gg

# ---------------------------------------------------------------------------
# Secret rotation (Issue #82)
# ---------------------------------------------------------------------------
# Every secret class below has a documented rotation procedure in
# docs/security/secret-rotation.md. The optional *_PREVIOUS variables enable a
# bounded overlap window so a rotation can complete without downtime. Only set
# them during an active rotation; unset them once the old key is retired.
# Never log or echo the values of any secret variable.

# JWT signing key overlap. When set, tokens signed with the previous key are
# still accepted until JWT_SECRET_PREVIOUS_RETIRE_AT (RFC3339) passes.
# JWT_SECRET_PREVIOUS=
# JWT_SECRET_PREVIOUS_RETIRE_AT=

# Payment webhook signing overlap (per active gateway).
# PAYSTACK_SECRET_PREVIOUS=
# FLUTTERWAVE_SECRET_PREVIOUS=

# Stellar signing key overlap. The previous admin key may only submit
# transactions during the overlap window; it is retired after the new key is
# confirmed on-chain.
# STELLAR_ADMIN_SECRET_PREVIOUS=

# Email provider key overlap.
# EMAIL_API_KEY_PREVIOUS=

# Object store credential overlap (rotate access key + secret together).
# S3_ACCESS_KEY_PREVIOUS=
# S3_SECRET_KEY_PREVIOUS=

# Database and Redis credentials are rotated via the managed provider; the
# application reads only DATABASE_URL / REDIS_URL and must be redeployed with
# the new connection string. No overlap variables are supported for these.

# Observability exporter credentials (OTLP auth header / API key).
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_HEADERS_PREVIOUS=

# ---------------------------------------------------------------------------
# Secret scanning (Issue #87)
# ---------------------------------------------------------------------------
# This file is a template only. NEVER commit real credentials here — CI runs a
# secret scanner over current content and history and fails on high-confidence
# findings. If a real secret is ever committed, deleting it from the file is
# NOT enough: it must be revoked/rotated at the provider. See
# docs/security/secret-exposure-response.md for the full response runbook.
#
# All values below are placeholder
